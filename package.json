    "@aws-sdk/s3-request-presigner": "^3.577.0",
    "@types/mime-types": "^3.0.1",
    "@types/pg": "^8.15.4",
    "@types/uuid": "^10.0.0",
    "apollo-server-express": "^3.10.1",
    "axios": "^0.27.2",
    "bcryptjs": "^3.0.3",
    "chrono-node": "^2.8.3",
    "class-validator": "^0.13.2",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.0.1",
    "express": "^4.18.1",
    "graphql": "^15.8.0",
