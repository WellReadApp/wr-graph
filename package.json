  "description": "GraphQL API for WellRead book summaries",
  "main": "index.js",
  "scripts": {
    "build": "tsc && tspath -f",
    "serve": "yarn clean && tsc; nodemon --exec 'tspath -f & node dist' --watch src",
    "test": "tsc && mocha dist/**/*.spec.js",
    "lint": "eslint . --ext .js,.ts",
    "tsc": "tsc",
    "nodemon": "nodemon dist",
    "tspath": "tspath -f",
    "clean": "rm -rf dist/"
  },
