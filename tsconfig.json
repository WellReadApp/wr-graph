{
  "allowSyntheticDefaultImports": true,
  "esModuleInterop": true,
  "compilerOptions": {
    "resolveJsonModule": true,
    "target": "es2017",
    "module": "commonjs",
    "outDir": "dist",
    "sourceMap": true,
    "esModuleInterop": true,
    "lib": ["es2017", "esnext.asynciterable"],
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "baseUrl": ".",
    "paths": {
      "@src/*": ["src/*"]
    },
    "skipLibCheck": true,  // Add this to skip type checking of declaration files
    "ignoreDeprecations": "5.0",  // Add this to handle TypeScript 5.x deprecations
    "moduleResolution": "node"
  },
  "files": [
    "./node_modules/@types/node/index.d.ts"
  ],
  "include": [
    "src/libs/**/*.ts",
    "src/graph/**/*.ts",
    "index.ts"
  ],
  "exclude": [
    "node_modules",
    "node_modules/@types/node/ts5.6/**/*" 
  ]
}
